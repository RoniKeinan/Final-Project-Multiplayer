# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# ========== Core Unity Folders ==========
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# ========== Firebase & Android Plugins ==========
/Assets/Plugins/Android/Firebase/*
/Assets/Plugins/Firebase/*
/Assets/Firebase/*
*.jar
*.aar
*.dex

# ========== Addressables ==========
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ========== Autogenerated Files ==========
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.obj
*.exe

# ========== Meta files ==========
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ========== OS & Editor Specific ==========
.vs/
.gradle/
.idea/
.DS_Store
Thumbs.db

# ========== JetBrains Rider Plugin ==========
/Assets/Plugins/Editor/JetBrains*

# ========== Crashlytics ==========
crashlytics-build.properties

# ========== Build Artifacts ==========
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# ========== Other Optional ==========
ExportedObj/
.consulo/
sysinfo.txt

# ========== Ignore TextMeshPro Extras ==========
Assets/TextMesh Pro/Examples & Extras/
